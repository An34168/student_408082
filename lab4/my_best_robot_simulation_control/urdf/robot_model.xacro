<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="my_best_model">

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.20 0.14 0.12"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.9 1.0"/>
            </material>
        </visual>
<collision>
    <geometry>
        <box size="0.20 0.14 0.12"/>
    </geometry>
</collision>

<inertial>
    <mass value="2.0"/>
    <inertia ixx="0.0056667" ixy="0" ixz="0"
             iyy="0.0090667" iyz="0"
             izz="0.0093333"/>
</inertial>

    </link>

<link name="arm_link_1">
    <visual>
        <geometry>
            <cylinder radius="0.025" length="0.15"/>
        </geometry>
        <material name="orange">
            <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
    </visual>
<collision>
    <geometry>
        <cylinder radius="0.025" length="0.15"/>
    </geometry>
</collision>

<inertial>
    <mass value="0.1"/>
    <inertia ixx="0.000203125" ixy="0" ixz="0"
             iyy="0.000203125" iyz="0"
             izz="0.00003125"/>
</inertial>
</link>

<joint name="joint_1" type="prismatic">
    <parent link="base_link"/>
    <child link="arm_link_1"/>

    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit lower="0.0"
           upper="0.12"
           effort="100"
           velocity="0.1"/>
</joint>

<link name="arm_link_2">
    <visual>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.02" length="0.20"/>
        </geometry>
        <material name="green">
            <color rgba="0.0 0.8 0.3 1.0"/>
        </material>
    </visual>
 <collision>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.02" length="0.20"/>
    </geometry>
</collision>
<inertial>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="0.000343333" ixy="0" ixz="0"
             iyy="0.000343333" iyz="0"
             izz="0.00002"/>
</inertial>
</link>

<joint name="joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>

    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

    <limit lower="-1.57"
           upper="1.57"
           effort="100"
           velocity="1.0"/>
</joint>

<link name="arm_link_3">
    <visual>
        <origin xyz="0 0 0.075" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.018" length="0.15"/>
        </geometry>
        <material name="purple">
            <color rgba="0.6 0.2 0.9 1.0"/>
        </material>
    </visual>
 <collision>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.018" length="0.15"/>
    </geometry>
</collision>
<inertial>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <mass value="0.08"/>
    <inertia ixx="0.00015648" ixy="0" ixz="0"
             iyy="0.00015648" iyz="0"
             izz="0.00001296"/>
</inertial>
</link>

<joint name="joint_3" type="revolute">
    <parent link="arm_link_2"/>
    <child link="arm_link_3"/>

    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

    <limit lower="-1.57"
           upper="1.57"
           effort="100"
           velocity="1.0"/>
</joint>

<link name="left_wheel">
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.025"/>
        </geometry>
        <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </visual>
<collision>
    <geometry>
        <cylinder radius="0.1" length="0.025"/>
    </geometry>
</collision>

<inertial>
    <mass value="0.2"/>
    <inertia ixx="0.000515625" ixy="0" ixz="0"
             iyy="0.000515625" iyz="0"
             izz="0.001"/>
</inertial>
</link>

<joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.082 -0.06" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>

    <limit effort="10" velocity="10"/>
</joint>

<link name="right_wheel">
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.025"/>
        </geometry>
        <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </visual>
<collision>
    <geometry>
        <cylinder radius="0.1" length="0.025"/>
    </geometry>
</collision>

<inertial>
    <mass value="0.2"/>
    <inertia ixx="0.000515625" ixy="0" ixz="0"
             iyy="0.000515625" iyz="0"
             izz="0.001"/>
</inertial>
</link>

<joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.082 -0.06" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>

    <limit effort="10" velocity="10"/>
</joint>


<link name="arm_link_4">
    <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.016" length="0.05"/>
        </geometry>
        <material name="yellow">
            <color rgba="1.0 0.9 0.1 1.0"/>
        </material>
    </visual>
 <collision>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.016" length="0.05"/>
    </geometry>
</collision>
<inertial>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <mass value="0.04"/>
    <inertia ixx="0.0000108933" ixy="0" ixz="0"
             iyy="0.0000108933" iyz="0"
             izz="0.00000512"/>
</inertial>
</link>

<joint name="joint_4_fixed" type="fixed">
    <parent link="arm_link_3"/>
    <child link="arm_link_4"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
</joint>

<link name="arm_link_5">
    <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.014" length="0.05"/>
        </geometry>
        <material name="cyan">
            <color rgba="0.0 0.8 0.9 1.0"/>
        </material>
    </visual>
 <collision>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.014" length="0.05"/>
    </geometry>
</collision>
<inertial>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <mass value="0.03"/>
    <inertia ixx="0.00000773" ixy="0" ixz="0"
             iyy="0.00000773" iyz="0"
             izz="0.00000294"/>
</inertial>
</link>

<joint name="joint_5_fixed" type="fixed">
    <parent link="arm_link_4"/>
    <child link="arm_link_5"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
</joint>

<link name="arm_link_6">
    <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.012" length="0.05"/>
        </geometry>
        <material name="white">
            <color rgba="0.9 0.9 0.9 1.0"/>
        </material>
    </visual>
 <collision>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.012" length="0.05"/>
    </geometry>
</collision>
<inertial>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <mass value="0.02"/>
    <inertia ixx="0.0000048867" ixy="0" ixz="0"
             iyy="0.0000048867" iyz="0"
             izz="0.00000144"/>
</inertial>
</link>

<joint name="joint_6_fixed" type="fixed">
    <parent link="arm_link_5"/>
    <child link="arm_link_6"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
</joint>
<ros2_control name="GazeboSimSystem" type="system">
    <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>
</ros2_control>
<gazebo>
    <plugin
        filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">

        <parameters>/home/user/ROS_2026/student_408082/lab4/my_best_robot_simulation_control/config/controllers.yaml</parameters>

        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>

    </plugin>
</gazebo>
<link name="front_support">
    <visual>
        <geometry>
            <sphere radius="0.025"/>
        </geometry>
        <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </visual>

    <collision>
        <geometry>
            <sphere radius="0.025"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="0.05"/>
        <inertia
            ixx="0.0000125"
            ixy="0"
            ixz="0"
            iyy="0.0000125"
            iyz="0"
            izz="0.0000125"/>
    </inertial>
</link>

<joint name="front_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_support"/>
    <origin xyz="0.085 0 -0.135" rpy="0 0 0"/>
</joint>
<link name="rear_support">
    <visual>
        <geometry>
            <sphere radius="0.025"/>
        </geometry>
        <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </visual>

    <collision>
        <geometry>
            <sphere radius="0.025"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="0.05"/>
        <inertia
            ixx="0.0000125"
            ixy="0"
            ixz="0"
            iyy="0.0000125"
            iyz="0"
            izz="0.0000125"/>
    </inertial>
</link>

<joint name="rear_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_support"/>
    <origin xyz="-0.085 0 -0.135" rpy="0 0 0"/>
</joint>
</robot>
